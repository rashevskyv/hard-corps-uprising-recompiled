@@ -0,0 +1,48 @@
+/**
+ * @file        rex/system/debug_saulo.h
+ * @brief       DEBUG_SAULO: temporary CPU diagnostics, removed together with the debug patch
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::system {
+class XThread;
+}
+
+namespace rex::system::debug_saulo {
+
+enum class Block : uint8_t { kSleep, kWait, kIo, kLock, kCount };
+
+void RegisterThread(XThread* thread);
+void UnregisterThread(XThread* thread);
+
+// Counts the time a guest thread spends blocked. Scopes nest; only the outermost one is counted.
+class BlockScope {
+ public:
+  explicit BlockScope(Block kind, uint32_t requested_ms = 0);
+  ~BlockScope();
+  void AddBytes(uint64_t bytes) { bytes_ += bytes; }
+
+  BlockScope(const BlockScope&) = delete;
+  BlockScope& operator=(const BlockScope&) = delete;
+
+ private:
+  Block kind_;
+  bool outermost_;
+  uint32_t requested_ms_;
+  uint64_t bytes_ = 0;
+  uint64_t start_ns_;
+};
+
+void NoteVblank(int64_t late_us);
+void NoteDeferredOverlapped(uint32_t delay_ms);
+void NoteFileOpen(bool failed);
+
+// The report lines for the time since the previous call; resets the counters.
+std::vector<std::string> TakeReport(double wall_seconds);
+
+}  // namespace rex::system::debug_saulo
