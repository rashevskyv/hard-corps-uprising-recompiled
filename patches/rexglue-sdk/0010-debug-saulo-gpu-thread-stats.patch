+      : total_(total), also_total_(also_total), start_(std::chrono::steady_clock::now()) {}
+  ~DebugSauloScopedNs() {
+    uint64_t ns = DebugSauloNsSince(start_);
+    total_ += ns;
+    if (also_total_) {
+      *also_total_ += ns;
+    }
+  }
