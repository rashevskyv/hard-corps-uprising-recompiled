diff --git a/src/core/mutex.cpp b/src/core/mutex.cpp
index d639924..dc23a1f 100644
--- a/src/core/mutex.cpp
+++ b/src/core/mutex.cpp
@@ -11,8 +11,33 @@
 
 #include <rex/thread/mutex.h>
 
+#include <atomic>
+#include <chrono>
+
 namespace rex::thread {
 
+namespace {
+std::atomic<uint64_t> g_debug_saulo_lock_waits{0};
+std::atomic<uint64_t> g_debug_saulo_lock_wait_ns{0};
+}  // namespace
+
+// DEBUG_SAULO
+void DebugSauloLockGlobalRegion(std::unique_lock<std::recursive_mutex>& lock) {
+  auto start = std::chrono::steady_clock::now();
+  lock.lock();
+  g_debug_saulo_lock_waits.fetch_add(1, std::memory_order_relaxed);
+  g_debug_saulo_lock_wait_ns.fetch_add(
+      uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start)
+                   .count()),
+      std::memory_order_relaxed);
+}
+
+// DEBUG_SAULO
+uint64_t DebugSauloTakeGlobalLockWait(uint64_t* count) {
+  *count = g_debug_saulo_lock_waits.exchange(0, std::memory_order_relaxed);
+  return g_debug_saulo_lock_wait_ns.exchange(0, std::memory_order_relaxed);
+}
+
 std::recursive_mutex& global_critical_region::mutex() {
   static std::recursive_mutex global_mutex;
   return global_mutex;
