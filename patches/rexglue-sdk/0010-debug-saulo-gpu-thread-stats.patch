+// DEBUG_SAULO
+bool D3D12CommandProcessor::DebugSauloTimestampsInitialize() {
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  ID3D12CommandQueue* queue = provider.GetDirectQueue();
+  constexpr uint32_t kTotalSlots = kDebugSauloTimestampSlots * kDebugSauloTimestampFrames;
+  if (!device || !queue || FAILED(queue->GetTimestampFrequency(&debug_saulo_ts_frequency_)) ||
+      !debug_saulo_ts_frequency_) {
+    return false;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kTotalSlots;
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kTotalSlots,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  void* mapping = nullptr;
+  D3D12_RANGE read_range = {0, sizeof(uint64_t) * kTotalSlots};
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&debug_saulo_ts_heap_))) ||
+      FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+          &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&debug_saulo_ts_readback_))) ||
+      FAILED(debug_saulo_ts_readback_->Map(0, &read_range, &mapping))) {
+    DebugSauloTimestampsShutdown();
+    return false;
+  }
+  debug_saulo_ts_mapping_ = reinterpret_cast<const uint64_t*>(mapping);
+  for (DebugSauloTimestampFrame& frame : debug_saulo_ts_frames_) {
+    frame = DebugSauloTimestampFrame{};
+  }
+  debug_saulo_ts_current_ = 0;
+  return true;
+}
+
+// DEBUG_SAULO
+void D3D12CommandProcessor::DebugSauloTimestampsShutdown() {
+  if (debug_saulo_ts_readback_ && debug_saulo_ts_mapping_) {
+    debug_saulo_ts_readback_->Unmap(0, nullptr);
+  }
+  debug_saulo_ts_mapping_ = nullptr;
+  debug_saulo_ts_readback_.Reset();
+  debug_saulo_ts_heap_.Reset();
+}
+
+// DEBUG_SAULO
+uint32_t D3D12CommandProcessor::DebugSauloGpuBegin(DebugSauloGpuCategory category) {
+  DebugSauloTimestampFrame& frame = debug_saulo_ts_frames_[debug_saulo_ts_current_];
+  if (!debug_saulo_ts_heap_ || !submission_open_ || frame.count + 4 > kDebugSauloTimestampSlots) {
+    return UINT32_MAX;
+  }
+  uint32_t slot = frame.count++;
+  frame.category[slot] = uint8_t(category);
+  frame.end_slot[slot] = 0;
+  deferred_command_list_.D3DEndQuery(debug_saulo_ts_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     debug_saulo_ts_current_ * kDebugSauloTimestampSlots + slot);
+  return slot;
+}
+
+// DEBUG_SAULO
+void D3D12CommandProcessor::DebugSauloGpuEnd(uint32_t token) {
+  DebugSauloTimestampFrame& frame = debug_saulo_ts_frames_[debug_saulo_ts_current_];
+  if (token == UINT32_MAX || !debug_saulo_ts_heap_ || !submission_open_ ||
+      frame.count + 2 > kDebugSauloTimestampSlots) {
+    return;
+  }
+  uint32_t slot = frame.count++;
+  frame.category[slot] = UINT8_MAX;
+  frame.end_slot[token] = uint16_t(slot);
+  deferred_command_list_.D3DEndQuery(debug_saulo_ts_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     debug_saulo_ts_current_ * kDebugSauloTimestampSlots + slot);
+}
+
+// DEBUG_SAULO: closes the frame being recorded and opens the next one, in the submission the swap
+// is recorded into.
+void D3D12CommandProcessor::DebugSauloGpuFrameEnd() {
+  if (!debug_saulo_ts_heap_ || !submission_open_) {
+    return;
+  }
+  DebugSauloTimestampFrame& frame = debug_saulo_ts_frames_[debug_saulo_ts_current_];
+  uint32_t frame_base = debug_saulo_ts_current_ * kDebugSauloTimestampSlots;
+  frame.end_mark = frame.count++;
+  frame.category[frame.end_mark] = UINT8_MAX;
+  deferred_command_list_.D3DEndQuery(debug_saulo_ts_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     frame_base + frame.end_mark);
+  deferred_command_list_.D3DResolveQueryData(
+      debug_saulo_ts_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, frame_base, frame.count,
+      debug_saulo_ts_readback_.Get(), sizeof(uint64_t) * frame_base);
+  frame.submission = submission_current_;
+
+  debug_saulo_ts_current_ = (debug_saulo_ts_current_ + 1) % kDebugSauloTimestampFrames;
+  DebugSauloTimestampFrame& next = debug_saulo_ts_frames_[debug_saulo_ts_current_];
+  next = DebugSauloTimestampFrame{};
+  next.has_start = true;
+  next.category[0] = UINT8_MAX;
+  next.count = 1;
+  deferred_command_list_.D3DEndQuery(debug_saulo_ts_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     debug_saulo_ts_current_ * kDebugSauloTimestampSlots);
+}
+
+// DEBUG_SAULO
+void D3D12CommandProcessor::DebugSauloCollectTimestamps() {
+  if (!debug_saulo_ts_mapping_) {
+    return;
+  }
+  for (uint32_t i = 0; i < kDebugSauloTimestampFrames; ++i) {
+    DebugSauloTimestampFrame& frame = debug_saulo_ts_frames_[i];
+    if (!frame.submission || submission_completed_ < frame.submission) {
+      continue;
+    }
+    const uint64_t* ticks = debug_saulo_ts_mapping_ + i * kDebugSauloTimestampSlots;
+    frame.submission = 0;
+    if (!frame.has_start || ticks[frame.end_mark] < ticks[0]) {
+      continue;
+    }
+    ++debug_saulo_.gpu_frames;
+    debug_saulo_.gpu_frame_ticks += ticks[frame.end_mark] - ticks[0];
+    for (uint32_t slot = 0; slot < frame.end_mark; ++slot) {
+      if (frame.category[slot] >= kDebugSauloCategoryCount || !frame.end_slot[slot] ||
+          ticks[frame.end_slot[slot]] < ticks[slot]) {
+        continue;
+      }
+      debug_saulo_.gpu_section_ticks[frame.category[slot]] +=
+          ticks[frame.end_slot[slot]] - ticks[slot];
+    }
+  }
+}
