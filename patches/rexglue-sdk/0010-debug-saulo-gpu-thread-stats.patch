+      stats.frames, stats.swap_gap_buckets[0], stats.swap_gap_buckets[1], stats.swap_gap_buckets[2],
+      stats.swap_gap_buckets[3], stats.swap_gap_buckets[4], stats.swap_gap_max_ms);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][CPU] guest indirect calls per frame: {:.0f} (counted only in builds with profiling "
+      "counters, which RelWithDebInfo has and Release does not)",
+      double(stats.guest_indirect_calls) / frames);
+  for (const std::string& line : rex::system::debug_saulo::TakeReport(wall_ns * 1e-9)) {
+    REXGPU_INFO("[DEBUG_SAULO][CPU] {}", line);
+  }
+  stats = DebugSauloStats{};
+  stats.interval_start = now;
+}
