+        double(stats.gpu_section_ticks[kDebugSauloDump]) * gpu_ms_per_tick);
+  }
+  REXGPU_INFO(
+      "[DEBUG_SAULO][CPU] time between swaps over {} frames: {} under 12 ms, {} 12-20 ms, {} 20-28 ms, {} "
