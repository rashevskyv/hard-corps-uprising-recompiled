new file mode 100644
index 0000000..18186dc
--- /dev/null
+++ b/src/system/debug_saulo.cpp
@@ -0,0 +1,490 @@
+/**
+ * @file        system/debug_saulo.cpp
+ * @brief       DEBUG_SAULO: temporary CPU diagnostics, removed together with the debug patch
+ */
+
+#include <rex/system/debug_saulo.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+
+#include <fmt/format.h>
+
+#include <rex/memory/utils.h>
+#include <rex/platform.h>
+#include <rex/ppc/context.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/thread_state.h>
+#include <rex/system/xmemory.h>
+#include <rex/system/xthread.h>
+#include <rex/thread.h>
+#include <rex/thread/mutex.h>
+
+#if REX_PLATFORM_WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <tlhelp32.h>
+#endif
+
+namespace rex::system::debug_saulo {
+namespace {
+
+constexpr int kKinds = int(Block::kCount);
+constexpr const char* kKindNames[kKinds] = {"sleep", "wait", "file I/O", "lock"};
+constexpr size_t kMaxSites = 48;
+constexpr size_t kMaxHits = 48;
+// The title's XAPI wrappers (Sleep, WaitForSingleObject, ...); the interesting caller is the first one outside.
+constexpr uint32_t kWrapperLow = 0x82570000;
+constexpr uint32_t kWrapperHigh = 0x82574000;
+
+uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+struct Hit {
+  uint32_t address = 0;
+  uint64_t count = 0;
+};
+
+struct Record {
+  XThread* thread = nullptr;
+  PPCContext* ctx = nullptr;
+  uint32_t id = 0;
+  uint32_t entry = 0;
+  uint32_t os_id = 0;
+  bool main = false;
+  std::atomic<uint8_t> blocked{0};  // 0 running, otherwise 1 + Block
+  std::atomic<uint64_t> calls[kKinds] = {};
+  std::atomic<uint64_t> ns[kKinds] = {};
+  std::atomic<uint64_t> io_bytes{0};
+  uint64_t samples = 0;
+  uint64_t samples_blocked[kKinds] = {};
+  Hit hits[kMaxHits] = {};
+};
+
+struct Site {
+  Block kind;
+  uint32_t address;
+  uint64_t calls;
+  uint64_t requested_ms;
+  uint64_t ns;
+};
+
+struct State {
+  std::mutex mutex;
+  std::vector<std::unique_ptr<Record>> records;
+  std::vector<Site> sites;
+  std::unordered_map<uint32_t, uint64_t> os_cpu_100ns;
+  std::once_flag sampler_started;
+  std::atomic<uint64_t> vblanks{0};
+  std::atomic<uint64_t> vblank_late_us{0};
+  std::atomic<uint64_t> vblank_late_max_us{0};
+  std::atomic<uint64_t> overlapped_count{0};
+  std::atomic<uint64_t> overlapped_ms{0};
+  std::atomic<uint64_t> opens{0};
+  std::atomic<uint64_t> opens_failed{0};
+};
+
+// Never freed: the sampler may still run while the process exits.
+State& GetState() {
+  static State* state = new State();
+  return *state;
+}
+
+thread_local Record* t_record = nullptr;
+thread_local int t_block_depth = 0;
+
+bool ReadGuest32(uint32_t address, uint32_t* out) {
+  auto* kernel = rex::system::kernel_state();
+  if (!kernel || address < 0x10000 || (address & 3)) {
+    return false;
+  }
+  auto* memory = kernel->memory();
+  if (!memory->LookupHeap(address)) {
+    return false;
+  }
+  *out = rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual(address));
+  return true;
+}
+
+// The first guest return address outside the XAPI wrappers, found through the saved link registers.
+uint32_t CallerSite(const PPCContext* ctx) {
+  uint32_t sp = uint32_t(ctx->r1.u64);
+  uint32_t lr = uint32_t(ctx->lr);
+  for (int hop = 0; hop < 4; ++hop) {
+    if (lr < kWrapperLow || lr >= kWrapperHigh) {
+      return lr;
+    }
+    uint32_t caller_sp;
+    if (!ReadGuest32(sp, &caller_sp) || caller_sp <= sp || caller_sp - sp > 0x100000 ||
+        !ReadGuest32(caller_sp - 8, &lr)) {
+      return lr;
+    }
+    sp = caller_sp;
+  }
+  return lr;
+}
+
+void AddSite(Block kind, uint32_t address, uint32_t requested_ms, uint64_t ns) {
+  State& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  for (Site& site : state.sites) {
+    if (site.kind == kind && site.address == address) {
+      ++site.calls;
+      site.requested_ms += requested_ms;
+      site.ns += ns;
+      return;
+    }
+  }
+  if (state.sites.size() < kMaxSites) {
+    state.sites.push_back({kind, address, 1, requested_ms, ns});
+  }
+}
+
+void AddHit(Record& record, uint32_t address) {
+  Hit* free_slot = nullptr;
+  for (Hit& hit : record.hits) {
+    if (hit.address == address) {
+      ++hit.count;
+      return;
+    }
+    if (!free_slot && !hit.address) {
+      free_slot = &hit;
+    }
+  }
+  if (free_slot) {
+    free_slot->address = address;
+    free_slot->count = 1;
+  }
+}
+
+void SamplerMain() {
+  State& state = GetState();
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    std::lock_guard<std::mutex> lock(state.mutex);
+    for (auto& record : state.records) {
+      if (!record->ctx) {
+        continue;
+      }
+      ++record->samples;
+      uint8_t blocked = record->blocked.load(std::memory_order_relaxed);
+      if (blocked) {
+        ++record->samples_blocked[blocked - 1];
+      } else {
+        AddHit(*record, uint32_t(record->ctx->lr));
+      }
+    }
+  }
+}
+
+struct OsThread {
+  uint32_t id;
+  uint64_t cpu_100ns;
+  std::string name;
+};
+
+#if REX_PLATFORM_WIN32
+std::vector<OsThread> SnapshotOsThreads() {
+  using GetThreadDescriptionFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+  static GetThreadDescriptionFn get_description = []() {
+    HMODULE kernel = GetModuleHandleW(L"kernel32.dll");
+    return kernel ? reinterpret_cast<GetThreadDescriptionFn>(GetProcAddress(kernel, "GetThreadDescription"))
+                  : nullptr;
+  }();
+  std::vector<OsThread> threads;
+  HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+  if (snapshot == INVALID_HANDLE_VALUE) {
+    return threads;
+  }
+  THREADENTRY32 entry = {};
+  entry.dwSize = sizeof(entry);
+  DWORD process_id = GetCurrentProcessId();
+  for (BOOL more = Thread32First(snapshot, &entry); more; more = Thread32Next(snapshot, &entry)) {
+    if (entry.th32OwnerProcessID != process_id) {
+      continue;
+    }
+    HANDLE handle = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, entry.th32ThreadID);
+    if (!handle) {
+      continue;
+    }
+    FILETIME created, exited, kernel_time, user_time;
+    if (GetThreadTimes(handle, &created, &exited, &kernel_time, &user_time)) {
+      OsThread thread;
+      thread.id = entry.th32ThreadID;
+      thread.cpu_100ns = ((uint64_t(kernel_time.dwHighDateTime) << 32) | kernel_time.dwLowDateTime) +
+                         ((uint64_t(user_time.dwHighDateTime) << 32) | user_time.dwLowDateTime);
+      PWSTR description = nullptr;
+      if (get_description && SUCCEEDED(get_description(handle, &description)) && description) {
+        for (const wchar_t* c = description; *c; ++c) {
+          thread.name += *c < 128 ? char(*c) : '?';
+        }
+        LocalFree(description);
+      }
+      threads.push_back(std::move(thread));
+    }
+    CloseHandle(handle);
+  }
+  CloseHandle(snapshot);
+  return threads;
+}
+#else
+std::vector<OsThread> SnapshotOsThreads() {
+  return {};
+}
+#endif
+
+std::string FormatSite(uint32_t address) {
+  return fmt::format("{:08X}", address);
+}
+
+std::string Percent(double ns, double wall_ns) {
+  return fmt::format("{:.0f}%", wall_ns > 0.0 ? 100.0 * ns / wall_ns : 0.0);
+}
+
+}  // namespace
+
+void RegisterThread(XThread* thread) {
+  State& state = GetState();
+  std::call_once(state.sampler_started, []() { std::thread(SamplerMain).detach(); });
+  auto record = std::make_unique<Record>();
+  record->thread = thread;
+  record->ctx = thread->thread_state() ? thread->thread_state()->context() : nullptr;
+  record->id = thread->thread_id();
+  record->entry = thread->creation_params()->start_address;
+  record->os_id = thread->thread() ? thread->thread()->system_id() : 0;
+  record->main = thread->main_thread();
+  t_record = record.get();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  state.records.push_back(std::move(record));
+}
+
+void UnregisterThread(XThread* thread) {
+  State& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  for (auto& record : state.records) {
+    if (record->thread == thread) {
+      record->thread = nullptr;
+      record->ctx = nullptr;
+      if (t_record == record.get()) {
+        t_record = nullptr;
+      }
+    }
+  }
+}
+
+BlockScope::BlockScope(Block kind, uint32_t requested_ms)
+    : kind_(kind),
+      outermost_(t_block_depth++ == 0),
+      requested_ms_(requested_ms),
+      start_ns_(NowNs()) {
+  if (outermost_ && t_record) {
+    t_record->blocked.store(uint8_t(1 + int(kind)), std::memory_order_relaxed);
+  }
+}
+
+BlockScope::~BlockScope() {
+  --t_block_depth;
+  if (!outermost_ || !t_record) {
+    return;
+  }
+  Record& record = *t_record;
+  uint64_t ns = NowNs() - start_ns_;
+  record.blocked.store(0, std::memory_order_relaxed);
+  record.calls[int(kind_)].fetch_add(1, std::memory_order_relaxed);
+  record.ns[int(kind_)].fetch_add(ns, std::memory_order_relaxed);
+  record.io_bytes.fetch_add(bytes_, std::memory_order_relaxed);
+  // Only blocking calls get a call site.
+  if (record.ctx && ns >= 50000) {
+    AddSite(kind_, CallerSite(record.ctx), requested_ms_, ns);
+  }
+}
+
+void NoteVblank(int64_t late_us) {
+  State& state = GetState();
+  uint64_t late = uint64_t(std::max<int64_t>(late_us, 0));
+  state.vblanks.fetch_add(1, std::memory_order_relaxed);
+  state.vblank_late_us.fetch_add(late, std::memory_order_relaxed);
+  uint64_t seen = state.vblank_late_max_us.load(std::memory_order_relaxed);
+  while (late > seen && !state.vblank_late_max_us.compare_exchange_weak(seen, late, std::memory_order_relaxed)) {
+  }
+}
+
+void NoteDeferredOverlapped(uint32_t delay_ms) {
+  State& state = GetState();
+  state.overlapped_count.fetch_add(1, std::memory_order_relaxed);
+  state.overlapped_ms.fetch_add(delay_ms, std::memory_order_relaxed);
+}
+
+void NoteFileOpen(bool failed) {
+  State& state = GetState();
+  state.opens.fetch_add(1, std::memory_order_relaxed);
+  if (failed) {
+    state.opens_failed.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+std::vector<std::string> TakeReport(double wall_seconds) {
+  State& state = GetState();
+  std::vector<std::string> lines;
+  const double wall_ns = wall_seconds * 1e9;
+
+  // Process threads by CPU time, and the CPU time of every registered guest thread.
+  std::vector<OsThread> os_threads = SnapshotOsThreads();
+  std::unordered_map<uint32_t, uint64_t> cpu_delta_100ns;
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    for (const OsThread& thread : os_threads) {
+      uint64_t& last = state.os_cpu_100ns[thread.id];
+      cpu_delta_100ns[thread.id] = thread.cpu_100ns >= last ? thread.cpu_100ns - last : 0;
+      last = thread.cpu_100ns;
+    }
+  }
+  if (wall_ns > 0.0) {
+    std::vector<std::pair<uint64_t, std::string>> ranked;
+    for (const OsThread& thread : os_threads) {
+      uint64_t delta = cpu_delta_100ns[thread.id];
+      std::string name = thread.name;
+      {
+        std::lock_guard<std::mutex> lock(state.mutex);
+        for (auto& record : state.records) {
+          if (record->os_id == thread.id && record->thread) {
+            name = fmt::format("{}guest {}", record->main ? "main " : "", record->id);
+          }
+        }
+      }
+      if (name.empty()) {
+        name = fmt::format("t{}", thread.id);
+      }
+      ranked.emplace_back(delta, name);
+    }
+    std::sort(ranked.begin(), ranked.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    std::string text;
+    for (size_t i = 0; i < ranked.size() && i < 7; ++i) {
+      text += fmt::format("{}{} {:.0f}%", i ? ", " : "", ranked[i].second,
+                          100.0 * double(ranked[i].first) * 100.0 / wall_ns);
+    }
+    lines.push_back(fmt::format("busiest threads (% of one core): {}", text));
+  }
+
+  std::vector<Site> sites;
+  uint64_t blocked_ns_total = 0;
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    sites.swap(state.sites);
+    // Guest threads: where the time went.
+    std::vector<Record*> guest;
+    for (auto& record : state.records) {
+      if (record->thread || record->samples) {
+        guest.push_back(record.get());
+      }
+    }
+    std::sort(guest.begin(), guest.end(), [&](Record* a, Record* b) {
+      uint64_t cpu_a = cpu_delta_100ns.count(a->os_id) ? cpu_delta_100ns[a->os_id] : 0;
+      uint64_t cpu_b = cpu_delta_100ns.count(b->os_id) ? cpu_delta_100ns[b->os_id] : 0;
+      return a->main != b->main ? a->main : cpu_a > cpu_b;
+    });
+    size_t shown = 0;
+    for (Record* record : guest) {
+      uint64_t cpu = cpu_delta_100ns.count(record->os_id) ? cpu_delta_100ns[record->os_id] : 0;
+      uint64_t calls[kKinds], ns[kKinds];
+      uint64_t blocked_ns = 0;
+      for (int k = 0; k < kKinds; ++k) {
+        calls[k] = record->calls[k].exchange(0);
+        ns[k] = record->ns[k].exchange(0);
+        blocked_ns += ns[k];
+      }
+      blocked_ns_total += blocked_ns;
+      uint64_t io_bytes = record->io_bytes.exchange(0);
+      uint64_t samples = record->samples;
+      uint64_t running = samples;
+      for (int k = 0; k < kKinds; ++k) {
+        running -= std::min(running, record->samples_blocked[k]);
+      }
+      bool report = record->main || (cpu * 100.0 > wall_ns * 0.02) || blocked_ns > wall_ns * 0.05;
+      if (report && wall_ns > 0.0 && shown < 6) {
+        ++shown;
+        std::string text = fmt::format("guest thread {}{} entry {:08X}: CPU {}", record->id,
+                                       record->main ? " (main)" : "", record->entry,
+                                       Percent(double(cpu) * 100.0, wall_ns));
+        for (int k = 0; k < kKinds; ++k) {
+          if (calls[k]) {
+            text += fmt::format(" | {} {} in {} calls", kKindNames[k], Percent(double(ns[k]), wall_ns), calls[k]);
+          }
+        }
+        if (io_bytes) {
+          text += fmt::format(" ({:.1f} MB read)", double(io_bytes) / (1024.0 * 1024.0));
+        }
+        text += fmt::format(" | sampled {} times, running in {}", samples,
+                            Percent(double(running), double(std::max<uint64_t>(samples, 1))));
+        lines.push_back(std::move(text));
+        // Where it was while running: the most frequent call sites.
+        std::array<Hit, kMaxHits> hits;
+        std::copy(std::begin(record->hits), std::end(record->hits), hits.begin());
+        std::sort(hits.begin(), hits.end(), [](const Hit& a, const Hit& b) { return a.count > b.count; });
+        std::string where;
+        for (size_t i = 0; i < 6 && hits[i].count; ++i) {
+          where += fmt::format("{}{} {}", i ? ", " : "", FormatSite(hits[i].address),
+                               Percent(double(hits[i].count), double(std::max<uint64_t>(running, 1))));
+        }
+        if (!where.empty() && (record->main || shown <= 3)) {
+          lines.push_back(fmt::format("  guest thread {} was running at (last call site): {}", record->id, where));
+        }
+      }
+      record->samples = 0;
+      std::fill(std::begin(record->samples_blocked), std::end(record->samples_blocked), 0);
+      std::fill(std::begin(record->hits), std::end(record->hits), Hit{});
+    }
+    // Registered threads that have ended are forgotten once reported.
+    state.records.erase(std::remove_if(state.records.begin(), state.records.end(),
+                                       [](const std::unique_ptr<Record>& r) { return !r->thread; }),
+                        state.records.end());
+  }
+
+  std::sort(sites.begin(), sites.end(), [](const Site& a, const Site& b) { return a.ns > b.ns; });
+  if (!sites.empty()) {
+    std::string text;
+    for (size_t i = 0; i < sites.size() && i < 5; ++i) {
+      const Site& site = sites[i];
+      text += fmt::format("{}{} from {} x{} {:.1f} ms", i ? "; " : "", kKindNames[int(site.kind)],
+                          FormatSite(site.address), site.calls, double(site.ns) * 1e-6);
+      if (site.kind == Block::kSleep) {
+        text += fmt::format(" (asked {} ms)", site.requested_ms);
+      }
+    }
+    lines.push_back(fmt::format("longest blocking call sites: {}", text));
+  }
+
+  uint64_t global_waits = 0;
+  uint64_t global_wait_ns = rex::thread::DebugSauloTakeGlobalLockWait(&global_waits);
+  uint64_t vblanks = state.vblanks.exchange(0);
+  uint64_t late_us = state.vblank_late_us.exchange(0);
+  uint64_t late_max_us = state.vblank_late_max_us.exchange(0);
+  uint64_t overlapped = state.overlapped_count.exchange(0);
+  uint64_t overlapped_ms = state.overlapped_ms.exchange(0);
+  uint64_t opens = state.opens.exchange(0);
+  uint64_t opens_failed = state.opens_failed.exchange(0);
+  lines.push_back(fmt::format(
+      "vblank: {} fired, late {:.2f} ms average, {:.2f} ms worst | global critical region: {} contended entries, "
+      "{:.1f} ms blocked | file opens: {} ({} failed) | deferred overlapped completions: {} ({} ms of delay)",
+      vblanks, vblanks ? double(late_us) / double(vblanks) * 1e-3 : 0.0, double(late_max_us) * 1e-3, global_waits,
+      double(global_wait_ns) * 1e-6, opens, opens_failed, overlapped, overlapped_ms));
+  (void)blocked_ns_total;
+  return lines;
+}
+
+}  // namespace rex::system::debug_saulo
