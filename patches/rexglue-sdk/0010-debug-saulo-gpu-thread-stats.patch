+// DEBUG_SAULO
+void D3D12CommandProcessor::DebugSauloOnSwap() {
+  DebugSauloCollectTimestamps();
+  DebugSauloStats& stats = debug_saulo_;
+  auto now = std::chrono::steady_clock::now();
+  D3D12RenderTargetCache::DebugSauloStats rt_stats;
+  D3D12SharedMemory::DebugSauloStats shared_memory_stats;
+  DrawExtentEstimator::DebugSauloStats estimator_stats;
+  auto take_subsystem_stats = [&]() {
+    if (render_target_cache_) {
+      rt_stats = std::exchange(render_target_cache_->debug_saulo_stats(),
+                               D3D12RenderTargetCache::DebugSauloStats{});
+      estimator_stats = render_target_cache_->DebugSauloTakeEstimatorStats();
+    }
+    if (shared_memory_) {
+      shared_memory_stats = std::exchange(shared_memory_->debug_saulo_stats(),
+                                          D3D12SharedMemory::DebugSauloStats{});
+    }
+  };
+  if (stats.interval_start == std::chrono::steady_clock::time_point{}) {
+    // Everything before the first frame (the startup) belongs to no interval.
+    stats = DebugSauloStats{};
+    stats.interval_start = now;
+    debug_saulo_last_swap_ = now;
+    take_subsystem_stats();
+    rex::system::debug_saulo::TakeReport(0.0);
+    return;
+  }
+  double swap_gap_ms = std::chrono::duration<double, std::milli>(now - debug_saulo_last_swap_).count();
+  debug_saulo_last_swap_ = now;
+  ++stats.swap_gap_buckets[swap_gap_ms < 12.0   ? 0
+                           : swap_gap_ms < 20.0 ? 1
+                           : swap_gap_ms < 28.0 ? 2
+                           : swap_gap_ms < 40.0 ? 3
+                                                : 4];
+  stats.swap_gap_max_ms = std::max(stats.swap_gap_max_ms, swap_gap_ms);
+  stats.guest_indirect_calls +=
+      uint64_t(rex::perf::GetSnapshotCounter(rex::perf::CounterId::kFunctionsDispatched));
+  if (++stats.frames < kDebugSauloIntervalFrames) {
+    return;
+  }
+  take_subsystem_stats();
+  double wall_ns = double(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                              now - stats.interval_start)
+                              .count());
+  double frames = double(stats.frames);
+  double idle_ns = double(stats.idle_ns - std::min(stats.idle_ns, stats.idle_fence_wait_ns));
+  double wait_ns = double(stats.fence_wait_ns);
+  double busy_ns = std::max(0.0, wall_ns - idle_ns - wait_ns);
+  double transfer_draws = double(rt_stats.transfer_draws);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][GPU] {} frames, {:.1f} fps | per frame: {:.0f} draws, {:.1f} resolves, {:.1f} "
+      "submissions from {:.1f} primary buffers, swap {:.2f} ms | GPU thread: {:.0f}% idle, {:.0f}% "
+      "waiting for the GPU, {:.0f}% busy",
+      stats.frames, frames * 1e9 / wall_ns, double(stats.draws) / frames,
+      double(stats.copies) / frames, double(stats.submissions) / frames,
+      double(stats.primary_buffers) / frames, double(stats.swap_ns) / frames * 1e-6,
+      100.0 * idle_ns / wall_ns, 100.0 * wait_ns / wall_ns, 100.0 * busy_ns / wall_ns);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][GPU] per frame: {:.1f} occlusion queries ({:.1f} blocking syncs), {:.1f} "
+      "memexport draws ({:.1f} blocking syncs), {:.1f} shared memory uploads ({:.2f} MB) | "
+      "extent estimator: {:.1f} vertex shader max Y runs ({:.0f} vertices), {:.1f} overwrite "
+      "position runs",
+      double(stats.occlusion_queries) / frames, double(stats.occlusion_syncs) / frames,
+      double(stats.memexport_draws) / frames, double(stats.memexport_syncs) / frames,
+      double(shared_memory_stats.upload_batches) / frames,
+      double(shared_memory_stats.upload_bytes) / frames / (1024.0 * 1024.0),
+      double(estimator_stats.max_y_estimates) / frames,
+      double(estimator_stats.max_y_vertices) / frames,
+      double(estimator_stats.position_runs) / frames);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][GPU] ownership transfers per frame: {:.1f} draws ({:.1f} color, {:.1f} depth, "
+      "{:.1f} stencil bit), {:.2f} MP, {:.0f} KP per draw, largest rectangle {}x{} | {:.1f} "
+      "color->color, {:.1f} color->depth, {:.1f} depth->color, {:.1f} depth->depth, {:.1f} from "
+      "the same EDRAM base, {:.1f} for resolve clears | draws needing transfers: {:.1f} rectangle "
+      "list, {:.1f} quad list, {:.1f} triangle strip, {:.1f} triangle list, {:.1f} other",
+      double(rt_stats.transfer_draws) / frames, double(rt_stats.transfer_draws_color) / frames,
+      double(rt_stats.transfer_draws_depth) / frames,
+      double(rt_stats.transfer_draws_stencil_bit) / frames,
+      double(rt_stats.transfer_pixels) / frames * 1e-6,
+      transfer_draws ? double(rt_stats.transfer_pixels) / transfer_draws * 1e-3 : 0.0,
+      rt_stats.transfer_max_width, rt_stats.transfer_max_height,
+      double(rt_stats.transfer_kind_draws[0]) / frames,
+      double(rt_stats.transfer_kind_draws[1]) / frames,
+      double(rt_stats.transfer_kind_draws[2]) / frames,
+      double(rt_stats.transfer_kind_draws[3]) / frames,
+      double(rt_stats.transfer_same_base_draws) / frames,
+      double(rt_stats.transfer_draws_resolve_clear) / frames,
+      double(rt_stats.transfer_update_primitives[0]) / frames,
+      double(rt_stats.transfer_update_primitives[1]) / frames,
+      double(rt_stats.transfer_update_primitives[2]) / frames,
+      double(rt_stats.transfer_update_primitives[3]) / frames,
+      double(rt_stats.transfer_update_primitives[4]) / frames);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][GPU] per frame: {:.1f} EDRAM dumps, {:.1f} depth stores, {:.1f} resolve "
+      "copies | {:.1f} resolve clears ({:.2f} MP), stencil clears {:.2f} MP | stencil bit draws "
+      "skipped {:.1f} ({:.2f} MP) | draw overwrite proofs: {:.1f} checked, {:.1f} proven, {:.1f} "
+      "transfers dropped, {:.1f} cut, {:.2f} MP saved",
+      double(rt_stats.dump_dispatches) / frames, double(rt_stats.depth_stores) / frames,
+      double(rt_stats.resolve_copies) / frames, double(rt_stats.clear_ops) / frames,
+      double(rt_stats.clear_pixels) / frames * 1e-6,
+      double(rt_stats.stencil_clear_pixels) / frames * 1e-6,
+      double(rt_stats.stencil_draws_skipped) / frames,
+      double(rt_stats.stencil_pixels_skipped) / frames * 1e-6,
+      double(rt_stats.overwrite_checks) / frames, double(rt_stats.overwrite_proofs) / frames,
+      double(rt_stats.overwrite_transfers_dropped) / frames,
+      double(rt_stats.overwrite_transfers_cut) / frames,
+      double(rt_stats.overwrite_pixels_saved) / frames * 1e-6);
+  {
+    double dump_tile_mp = 80.0 * 16.0 * 1e-6;
+    if (render_target_cache_) {
+      dump_tile_mp *= double(render_target_cache_->draw_resolution_scale_x()) *
+                      double(render_target_cache_->draw_resolution_scale_y());
+    }
+    REXGPU_INFO(
+        "[DEBUG_SAULO][GPU] resolve efficiency per frame: {:.1f} resolves ({:.1f} depth, {:.1f} "
+        "MSAA), {:.1f} with every source tile current, {:.1f} repeated signatures ({:.1f} with the "
+        "source current) | EDRAM dump tiles: {:.0f} of {:.0f} dumped ({:.2f} of {:.2f} MP), "
+        "{:.1f} dispatches skipped",
+        double(rt_stats.resolve_requests) / frames, double(rt_stats.resolve_depth) / frames,
+        double(rt_stats.resolve_msaa) / frames, double(rt_stats.resolve_dump_all_current) / frames,
+        double(rt_stats.resolve_repeats) / frames,
+        double(rt_stats.resolve_repeats_source_current) / frames,
+        double(rt_stats.dump_tiles_executed) / frames,
+        double(rt_stats.dump_tiles_requested) / frames,
+        double(rt_stats.dump_tiles_executed) / frames * dump_tile_mp,
+        double(rt_stats.dump_tiles_requested) / frames * dump_tile_mp,
+        double(rt_stats.dump_dispatches_skipped) / frames);
+  }
+  REXGPU_INFO("[DEBUG_SAULO][GPU] guest memory wake calls per frame: {:.1f}",
+              double(rex::graphics::DebugSauloTakeGuestWakeCalls()) / frames);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][GPU] stencil per frame: {:.1f} depth transfers rebuilding stencil, {:.2f} "
+      "bit passes each, {:.1f} with no stencil to copy ({:.1f} from color), stencil clear {:.2f} "
+      "MP skipped | same EDRAM base draws by difference: {:.1f} color/depth, {:.1f} pitch, {:.1f} "
+      "MSAA, {:.1f} format, {:.1f} several | claim {:.2f} MP left to other owners",
+      double(rt_stats.stencil_transfers) / frames,
+      rt_stats.stencil_transfers
+          ? double(rt_stats.stencil_active_bits) / double(rt_stats.stencil_transfers)
+          : 0.0,
+      double(rt_stats.stencil_zero_transfers) / frames,
+      double(rt_stats.stencil_color_source_zero_transfers) / frames,
+      double(rt_stats.stencil_clear_pixels_skipped) / frames * 1e-6,
+      double(rt_stats.transfer_same_base_reasons[0]) / frames,
+      double(rt_stats.transfer_same_base_reasons[1]) / frames,
+      double(rt_stats.transfer_same_base_reasons[2]) / frames,
+      double(rt_stats.transfer_same_base_reasons[3]) / frames,
+      double(rt_stats.transfer_same_base_reasons[4]) / frames,
+      double(rt_stats.claim_pixels_skipped) / frames * 1e-6);
+  if (stats.gpu_frames) {
+    double gpu_ms_per_tick = 1000.0 / double(debug_saulo_ts_frequency_) / double(stats.gpu_frames);
+    REXGPU_INFO(
+        "[DEBUG_SAULO][GPU] timeline over {} frames, per frame: {:.2f} ms total | resolves "
+        "(including their dumps and clears) {:.2f} ms, ownership transfers {:.2f} ms, ownership "
+        "clears {:.2f} ms, EDRAM dumps {:.2f} ms",
+        stats.gpu_frames, double(stats.gpu_frame_ticks) * gpu_ms_per_tick,
