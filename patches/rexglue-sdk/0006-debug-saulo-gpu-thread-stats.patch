+// DEBUG_SAULO
+void D3D12CommandProcessor::DebugSauloOnSwap() {
+  DebugSauloCollectTimestamps();
+  DebugSauloStats& stats = debug_saulo_;
+  auto now = std::chrono::steady_clock::now();
+  D3D12RenderTargetCache::DebugSauloStats rt_stats;
+  D3D12SharedMemory::DebugSauloStats shared_memory_stats;
+  DrawExtentEstimator::DebugSauloStats estimator_stats;
+  auto take_subsystem_stats = [&]() {
+    if (render_target_cache_) {
+      rt_stats = std::exchange(render_target_cache_->debug_saulo_stats(),
+                               D3D12RenderTargetCache::DebugSauloStats{});
+      estimator_stats = render_target_cache_->DebugSauloTakeEstimatorStats();
+    }
+    if (shared_memory_) {
+      shared_memory_stats = std::exchange(shared_memory_->debug_saulo_stats(),
+                                          D3D12SharedMemory::DebugSauloStats{});
+    }
+  };
+  if (stats.interval_start == std::chrono::steady_clock::time_point{}) {
+    // Everything before the first frame (the startup) belongs to no interval.
+    stats = DebugSauloStats{};
+    stats.interval_start = now;
+    take_subsystem_stats();
+    return;
+  }
+  if (++stats.frames < kDebugSauloIntervalFrames) {
+    return;
+  }
+  take_subsystem_stats();
+  double wall_ns = double(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                              now - stats.interval_start)
+                              .count());
+  double frames = double(stats.frames);
+  double idle_ns = double(stats.idle_ns - std::min(stats.idle_ns, stats.idle_fence_wait_ns));
+  double wait_ns = double(stats.fence_wait_ns);
+  double busy_ns = std::max(0.0, wall_ns - idle_ns - wait_ns);
+  double transfer_draws = double(rt_stats.transfer_draws);
+  REXGPU_INFO(
+      "[DEBUG_SAULO][GPU] {} frames, {:.1f} fps | per frame: {:.0f} draws, {:.1f} resolves, {:.1f} "
+      "submissions from {:.1f} primary buffers, swap {:.2f} ms | GPU thread: {:.0f}% idle, {:.0f}% "
