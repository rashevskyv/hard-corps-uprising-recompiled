+// DEBUG_SAULO
+class DebugSauloScopedNs {
+ public:
+  explicit DebugSauloScopedNs(uint64_t& total, uint64_t* also_total = nullptr)
+      : total_(total), also_total_(also_total), start_(std::chrono::steady_clock::now()) {}
+  ~DebugSauloScopedNs() {
+    uint64_t ns = DebugSauloNsSince(start_);
+    total_ += ns;
